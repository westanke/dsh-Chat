{
  "app": {
    // ── 签名配置：**保持为空**（照搬 dsh-companion-harmony 2026-10-15 定下的口径）──
    //
    // hvigor 的 SignHap 任务拒收明文口令（00303116：storePassword/keyPassword 必须
    // ≥32 字符的 DevEco 加密串），本机只有命令行工具没有 DevEco Studio，
    // 填明文只会让构建直接失败。
    // 所以签名由 SDK 自带的 `hap-sign-tool.jar` 手工完成（-keystorePwd/-keyPwd 吃明文，
    // 是华为给 CI 的标准路子），`hvigorw assembleHap` 产出未签名 HAP ——
    // 日志里 `WARN: No signingConfig` 属**预期输出**。完整命令见 docs/RELEASE.md。
    // AGC 材料齐后若装了 DevEco，可把加密串填回并在这里加 "signingConfig"。
    //
    // ⚠️ 别把明文口令填进本文件：既构建失败，又会把密钥库口令写进会被提交的配置里。
    // ──────────────────────────────────────────────────────────────
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.1.0(18)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyToProducts": [ "default" ] }
      ]
    }
  ]
}
